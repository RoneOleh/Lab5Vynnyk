<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fitsSystemWindows="true">
    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_vertical" android:orientation="vertical" android:padding="24dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.08" android:text="LAB 05"
                android:textColor="@color/accent_dark" android:textSize="13sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/second_title"
                android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:lineSpacingExtra="4dp"
                android:text="@string/second_description"
                android:textColor="@color/text_secondary" android:textSize="16sp" />
            <TextView
                android:id="@+id/intent_info"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:background="@drawable/bg_intent_box"
                android:fontFamily="monospace" android:lineSpacingExtra="4dp" android:padding="16dp"
                android:textColor="@color/accent_dark" android:textSize="13sp" />
            <Button
                android:id="@+id/btn_back"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="28dp" android:background="@drawable/bg_button"
                android:minHeight="48dp" android:onClick="goback" android:text="@string/back"
                android:textAllCaps="false" android:textColor="@color/on_accent"
                android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
