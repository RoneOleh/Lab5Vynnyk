<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fitsSystemWindows="true">
    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_vertical" android:orientation="vertical" android:padding="24dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.08" android:text="LAB 05"
                android:textColor="@color/accent_dark" android:textSize="13sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/third_title"
                android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:lineSpacingExtra="4dp"
                android:text="@string/third_description"
                android:textColor="@color/text_secondary" android:textSize="16sp" />
            <TextView
                android:id="@+id/counter_text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:gravity="center"
                android:text="0" android:textColor="@color/accent_dark"
                android:textSize="64sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/third_counter_label"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView
                android:id="@+id/action_result"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:minHeight="40dp"
                android:text="@string/third_msg_0" android:textColor="@color/text"
                android:textSize="15sp" />
            <Button
                android:id="@+id/action_button"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button"
                android:onClick="performAction" android:text="@string/third_action"
                android:textAllCaps="false" android:textColor="@color/on_accent"
                android:textSize="17sp" android:textStyle="bold" />
            <Button
                android:id="@+id/btn_back"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="28dp" android:background="@drawable/bg_button"
                android:minHeight="48dp" android:onClick="goback" android:text="@string/back"
                android:textAllCaps="false" android:textColor="@color/on_accent"
                android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <com.example.lab5.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
