<?xml version="1.0" encoding="utf-8"?>
<!-- Сітка: відступ 7% | кнопка 20% | 2% | кнопка 20% | 2% | кнопка 20% | 2% | кнопка 20% | відступ 7% -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.07" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.27" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.29" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.49" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.51" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.71" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.73" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.93" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.125" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gl_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.875" />

    <TextView
        android:id="@+id/menu_label"
        android:layout_width="wrap_content" android:layout_height="0dp"
        android:gravity="center_vertical" android:letterSpacing="0.08"
        android:text="@string/menu_label" android:textColor="@color/accent_dark"
        android:textSize="11sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/gl_0"
        app:layout_constraintStart_toStartOf="@id/gl_start" />

    <LinearLayout
        android:id="@+id/theme_toggle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_seg" android:padding="2dp"
        android:clickable="true" android:focusable="true"
        android:contentDescription="@string/cd_toggle_theme"
        android:onClick="toggleTheme" android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/gl_0"
        app:layout_constraintEnd_toEndOf="@id/gl_end">
        <ImageView
            android:id="@+id/icon_sun"
            android:layout_width="32dp" android:layout_height="28dp" android:padding="5dp"
            android:src="@drawable/ic_sun" android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/icon_moon"
            android:layout_width="32dp" android:layout_height="28dp" android:padding="5dp"
            android:src="@drawable/ic_moon" android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_nav"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_menu_primary"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="10dp"
        android:onClick="openSecond"
        app:layout_constraintTop_toBottomOf="@id/gl_0"
        app:layout_constraintBottom_toTopOf="@id/gl_1"
        app:layout_constraintStart_toStartOf="@id/gl_start"
        app:layout_constraintEnd_toEndOf="@id/gl_end">
        <ImageView
            android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/bg_tile_primary" android:padding="8dp"
            android:src="@drawable/ic_compass" android:tint="@color/on_accent"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_nav" android:textColor="@color/on_accent"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:alpha="0.85"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_nav_sub" android:textColor="@color/on_accent"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_chevron" android:tint="@color/on_accent"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_interactive"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_menu_secondary"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="10dp"
        android:onClick="openThird"
        app:layout_constraintTop_toBottomOf="@id/gl_2"
        app:layout_constraintBottom_toTopOf="@id/gl_3"
        app:layout_constraintStart_toStartOf="@id/gl_start"
        app:layout_constraintEnd_toEndOf="@id/gl_end">
        <ImageView
            android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/bg_tile_accent" android:padding="8dp"
            android:src="@drawable/ic_touch" android:tint="@color/on_accent"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_interactive" android:textColor="@color/accent_dark"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:alpha="1"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_interactive_sub" android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_chevron" android:tint="@color/accent_dark"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_about"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_menu_secondary"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="10dp"
        android:onClick="openFourth"
        app:layout_constraintTop_toBottomOf="@id/gl_4"
        app:layout_constraintBottom_toTopOf="@id/gl_5"
        app:layout_constraintStart_toStartOf="@id/gl_start"
        app:layout_constraintEnd_toEndOf="@id/gl_end">
        <ImageView
            android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/bg_tile_dark" android:padding="8dp"
            android:src="@drawable/ic_info" android:tint="@color/on_accent"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_about" android:textColor="@color/accent_dark"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:alpha="1"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_about_sub" android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_chevron" android:tint="@color/accent_dark"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_exit"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_menu_exit"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="10dp"
        android:onClick="exitApp"
        app:layout_constraintTop_toBottomOf="@id/gl_6"
        app:layout_constraintBottom_toTopOf="@id/gl_7"
        app:layout_constraintStart_toStartOf="@id/gl_start"
        app:layout_constraintEnd_toEndOf="@id/gl_end">
        <ImageView
            android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/bg_tile_danger" android:padding="8dp"
            android:src="@drawable/ic_logout" android:tint="@color/danger"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_exit" android:textColor="@color/danger"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:alpha="1"
                android:ellipsize="end" android:maxLines="1"
                android:text="@string/menu_exit_sub" android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_chevron" android:tint="@color/danger"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/voice_button"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:background="@drawable/bg_pill_voice"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="16dp"
        android:onClick="startVoiceInput"
        app:layout_constraintTop_toBottomOf="@id/gl_7" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/voice_icon"
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_mic" android:tint="@color/inverse_text"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="@string/voice_button"
            android:textColor="@color/inverse_text" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
